{
  "name": "zennotes-web-clipper",
  "version": "0.1.0",
  "private": true,
  "description": "Clip web pages into ZenNotes as Markdown notes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-fixtures": "node scripts/sync-fixtures.mjs",
    "run:firefox": "web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "build:e2e": "node scripts/build.mjs --e2e",
    "e2e:chrome": "node scripts/e2e-chrome.mjs",
    "e2e:firefox": "node scripts/e2e-firefox.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "defuddle": "^0.19.6",
    "dompurify": "^3.4.17",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.2",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "web-ext": "^8.3.0"
  }
}
