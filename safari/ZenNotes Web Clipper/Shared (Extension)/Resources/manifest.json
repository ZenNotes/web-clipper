{
  "manifest_version": 3,
  "name": "ZenNotes Web Clipper",
  "short_name": "ZenNotes Clipper",
  "description": "Clip web pages, selections and highlights into ZenNotes as clean Markdown notes. No account, no server.",
  "version": "0.1.0",
  "homepage_url": "https://zennotes.org",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ZenNotes Web Clipper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "contextMenus",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Open the clipper"
    },
    "quick-clip": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Clip this page with its template"
    },
    "toggle-highlighter": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Turn the highlighter on or off"
    },
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Turn reader view on or off"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  }
}
